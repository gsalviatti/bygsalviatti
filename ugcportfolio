      <div><div class="hero-stat-num">2.8K</div><div class="hero-stat-label">Followers</div></div>
      <div><div class="hero-stat-num">BR+US</div><div class="hero-stat-label">Dual Market</div></div>
      <div><div class="hero-stat-num">4+</div><div class="hero-stat-label">Niches</div></div>
    </div>
  </div>
  <div class="hero-right">
    <div class="collage-img ci-main">
      <img src="data:image/jpeg;base64," alt="Gabi Salviatti"/>
      <div class="collage-badge">UGC<span>Creator</span></div>
