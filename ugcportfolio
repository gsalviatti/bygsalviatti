      <img src="data:image/jpeg;base64," alt="Oakberry Acai"/>
    </div>
    <div class="collage-img ci-3">
      <img src="data:image/jpeg;base64," alt="Mana Poke"/>
    </div>
    <div class="collage-img ci-4">
      <img src="data:image/jpeg;base64," alt="Product UGC"/>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <span class="marquee-item">UGC Creator</span><span class="marquee-dot">✦</span>
