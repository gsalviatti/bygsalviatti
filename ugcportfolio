<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Gabi Salviatti UGC Creator Portfolio</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --cream: #faf7f2;
      --warm: #f5ede0;
      --sand: #e8d5b7;
      --sand-dark: #c9a87a;
      --rose: #c4856a;
      --rose-light: #e0a990;
      --brown: #5c3d2e;
      --brown-light: #8b6347;
      --text: #2a1f1a;
      --muted: #7a6458;
      --border: rgba(92,61,46,0.12);
      --white: #fffdf9;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:'DM Sans',sans-serif; background:var(--cream); color:var(--text); overflow-x:hidden; }

    /* NAVBAR */
    nav {
      position:fixed; top:0; left:0; right:0; z-index:100;
      display:flex; justify-content:space-between; align-items:center;
      padding:18px 48px;
      background:rgba(250,247,242,0.92); backdrop-filter:blur(16px);
      border-bottom:1px solid var(--border);
    }
    .nav-logo { font-family:'Playfair Display',serif; font-size:1.25rem; font-weight:900; color:var(--text); text-decoration:none; letter-spacing:-0.01em; }
    .nav-logo span { color:var(--rose); font-style:italic; }
    .nav-links { display:flex; gap:28px; align-items:center; }
    .nav-links a { font-size:0.8rem; font-weight:500; letter-spacing:0.06em; text-transform:uppercase; color:var(--muted); text-decoration:none; transition:color 0.2s; }
    .nav-links a:hover { color:var(--text); }
    .nav-cta { background:var(--rose) !important; color:#fff !important; padding:9px 22px; border-radius:100px; font-size:0.78rem !important; letter-spacing:0.04em !important; }
    .nav-cta:hover { background:var(--rose-light) !important; }

    /* HERO */
    .hero { min-height:100vh; padding:110px 48px 80px; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; max-width:1300px; margin:0 auto; }
    .hero-tag { display:inline-flex; align-items:center; gap:10px; font-size:0.72rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--rose); margin-bottom:22px; }
    .hero-tag::before { content:''; width:28px; height:1.5px; background:var(--rose); }
    .hero-title { font-family:'Playfair Display',serif; font-size:clamp(2.8rem,5vw,5rem); font-weight:900; line-height:1.05; letter-spacing:-0.03em; color:var(--text); margin-bottom:22px; }
    .hero-title em { display:block; color:var(--rose); font-style:italic; }
    .hero-desc { font-size:1rem; color:var(--muted); line-height:1.8; max-width:460px; margin-bottom:36px; font-weight:400; }
    .hero-desc strong { color:var(--text); font-weight:600; }
    .hero-btns { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:52px; }
    .btn-rose { background:var(--rose); color:#fff; padding:13px 30px; border-radius:100px; font-weight:600; font-size:0.9rem; text-decoration:none; transition:all 0.25s; box-shadow:0 4px 20px rgba(196,133,106,0.3); }
    .btn-rose:hover { background:var(--rose-light); transform:translateY(-2px); color:#fff; }
    .btn-ghost { background:transparent; color:var(--text); border:1.5px solid var(--sand-dark); padding:13px 30px; border-radius:100px; font-weight:500; font-size:0.9rem; text-decoration:none; transition:all 0.25s; }
    .btn-ghost:hover { border-color:var(--rose); color:var(--rose); }
    .hero-stats { display:flex; gap:36px; }
    .hero-stat-num { font-family:'Playfair Display',serif; font-size:1.9rem; font-weight:900; color:var(--text); line-height:1; }
    .hero-stat-label { font-size:0.7rem; color:var(--muted); letter-spacing:0.04em; margin-top:3px; }

    /* HERO RIGHT photo collage */
    .hero-right { position:relative; height:580px; }
    .collage-img {
      position:absolute; border-radius:16px; overflow:hidden;
      box-shadow:0 12px 40px rgba(92,61,46,0.15);
      transition:transform 0.3s ease;
    }
    .collage-img img { width:100%; height:100%; object-fit:cover; display:block; }
    .collage-img:hover { transform:translateY(-4px) scale(1.02); z-index:10; }
    .ci-main { width:220px; height:300px; top:0; left:40px; z-index:3; }
    .ci-2 { width:180px; height:240px; top:20px; right:20px; z-index:2; transform:rotate(2deg); }
    .ci-3 { width:200px; height:220px; bottom:20px; left:10px; z-index:2; transform:rotate(-2deg); }
    .ci-4 { width:160px; height:200px; bottom:40px; right:40px; z-index:3; transform:rotate(1deg); }
    .collage-badge {
      position:absolute; bottom:-14px; right:-14px;
      background:var(--rose); color:#fff;
      width:72px; height:72px; border-radius:50%;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      font-family:'Playfair Display',serif; font-size:1rem; font-weight:900;
      box-shadow:0 6px 20px rgba(196,133,106,0.4);
      border:3px solid var(--cream); z-index:20;
    }
    .collage-badge span { font-family:'DM Sans',sans-serif; font-size:0.5rem; letter-spacing:0.06em; margin-top:1px; }

    /* MARQUEE */
    .marquee-wrap { background:var(--brown); padding:14px 0; overflow:hidden; white-space:nowrap; }
    .marquee-track { display:inline-flex; animation:marquee 22s linear infinite; }
    @keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    .marquee-item { font-size:0.75rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:var(--sand); padding:0 28px; }
    .marquee-dot { color:var(--rose-light); margin:0 6px; }

    /* ABOUT */
    .about { padding:100px 48px; background:var(--white); }
    .about-grid { display:grid; grid-template-columns:1fr 1.5fr; gap:80px; align-items:center; max-width:1200px; margin:0 auto; }
    .about-img-wrap { position:relative; }
    .about-img { width:100%; aspect-ratio:3/4; border-radius:20px; overflow:hidden; box-shadow:0 16px 50px rgba(92,61,46,0.15); }
    .about-img img { width:100%; height:100%; object-fit:cover; object-position:top center; }
    .about-img-tag { position:absolute; bottom:20px; left:-20px; background:var(--rose); color:#fff; padding:10px 18px; border-radius:12px; font-size:0.75rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; box-shadow:0 4px 16px rgba(196,133,106,0.35); }
    .eyebrow { font-size:0.72rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--rose); margin-bottom:14px; }
    .section-title { font-family:'Playfair Display',serif; font-size:2.6rem; font-weight:900; line-height:1.1; letter-spacing:-0.02em; margin-bottom:20px; }
    .section-title em { color:var(--rose); font-style:italic; }
    .about-text { font-size:0.95rem; color:var(--muted); line-height:1.85; margin-bottom:14px; }
    .about-text strong { color:var(--text); }
    .pill-row { display:flex; flex-wrap:wrap; gap:8px; margin:20px 0; }
    .pill { display:inline-flex; align-items:center; gap:6px; background:var(--warm); border:1px solid var(--border); padding:6px 14px; border-radius:100px; font-size:0.78rem; font-weight:500; color:var(--text); }
    .stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:28px; }
    .stat-box { background:var(--cream); border:1px solid var(--border); border-radius:14px; padding:18px; }
    .stat-num { font-family:'Playfair Display',serif; font-size:1.7rem; font-weight:900; color:var(--rose); line-height:1; }
    .stat-label { font-size:0.7rem; color:var(--muted); margin-top:3px; }

    /* PORTFOLIO GRID */
    .work { padding:100px 48px; background:var(--cream); }
    .work-inner { max-width:1200px; margin:0 auto; }
    .section-header { margin-bottom:48px; }
    .work-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .work-item {
      border-radius:16px; overflow:hidden; position:relative;
      cursor:pointer; transition:transform 0.3s, box-shadow 0.3s;
      box-shadow:0 4px 20px rgba(92,61,46,0.1);
    }
    .work-item:hover { transform:translateY(-5px); box-shadow:0 16px 40px rgba(92,61,46,0.18); }
    .work-item:hover .work-overlay { opacity:1; }
    .work-img { width:100%; aspect-ratio:4/5; object-fit:cover; display:block; }
    .work-overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(42,31,26,0.85) 40%, transparent); display:flex; flex-direction:column; justify-content:flex-end; padding:18px; opacity:0; transition:opacity 0.3s; }
    .work-type { font-size:0.65rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--rose-light); margin-bottom:4px; }
    .work-loc { font-size:0.7rem; color:rgba(255,255,255,0.6); margin-top:4px; }
    .work-title { font-family:'Playfair Display',serif; font-size:1rem; color:#fff; font-weight:700; line-height:1.2; }
    .work-badge { position:absolute; top:12px; left:12px; background:rgba(255,253,249,0.9); backdrop-filter:blur(4px); font-size:0.62rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--text); padding:3px 10px; border-radius:20px; }
    .work-badge.video { background:var(--rose); color:#fff; }

    /* TIKTOK PHONES */
    .videos { padding:100px 48px; background:var(--brown); }
    .videos-inner { max-width:1200px; margin:0 auto; }
    .videos-header { margin-bottom:56px; }
    .videos-eyebrow { font-size:0.72rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--rose-light); margin-bottom:14px; }
    .videos-title { font-family:'Playfair Display',serif; font-size:2.6rem; font-weight:900; color:var(--warm); line-height:1.1; letter-spacing:-0.02em; }
    .videos-title em { color:var(--rose-light); font-style:italic; }
    .videos-sub { font-size:0.9rem; color:#9a8070; margin-top:10px; max-width:480px; line-height:1.7; }
    .phones-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
    .phone-frame {
      background:#1a1a1a; border-radius:32px; overflow:hidden;
      padding:6px; box-shadow:0 20px 50px rgba(0,0,0,0.5);
      transition:transform 0.3s;
      border:2px solid rgba(255,255,255,0.08);
    }
    .phone-frame:hover { transform:translateY(-6px) rotate(-1deg); }
    .phone-screen { border-radius:28px; overflow:hidden; aspect-ratio:9/16; background:#000; position:relative; }
    .phone-screen iframe { width:100%; height:100%; border:none; }
    .phone-notch { position:absolute; top:0; left:50%; transform:translateX(-50%); width:80px; height:20px; background:#1a1a1a; border-radius:0 0 14px 14px; z-index:10; }
    .phone-caption { text-align:center; padding:12px 8px 8px; }
    .phone-niche { font-size:0.65rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--rose-light); margin-bottom:3px; }
    .phone-title { font-size:0.78rem; color:#c8b0a0; line-height:1.3; }

    /* NICHES */
    .niches { padding:100px 48px; background:var(--white); }
    .niches-inner { max-width:1200px; margin:0 auto; }
    .niches-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:56px; }
    .niche-card { border-radius:20px; padding:36px; position:relative; overflow:hidden; transition:transform 0.3s; }
    .niche-card:hover { transform:scale(1.02); }
    .nc-food { background:linear-gradient(145deg,#f5e8d5,#e8c8a0); }
    .nc-wellness { background:linear-gradient(145deg,#d5e8d5,#a8c8a0); }
    .nc-travel { background:linear-gradient(145deg,#d5e0f0,#9ab5d8); }
    .nc-cross { background:linear-gradient(145deg,#2a1f1a,#5c3d2e); color:var(--sand); }
    .niche-emoji { font-size:3rem; margin-bottom:14px; display:block; }
    .niche-name { font-family:'Playfair Display',serif; font-size:1.5rem; font-weight:900; margin-bottom:8px; color:var(--text); }
    .nc-cross .niche-name { color:var(--sand); }
    .niche-desc { font-size:0.85rem; line-height:1.7; color:var(--muted); margin-bottom:16px; }
    .nc-cross .niche-desc { color:#c8a888; }
    .niche-tags { display:flex; flex-wrap:wrap; gap:6px; }
    .niche-tag { background:rgba(255,255,255,0.5); font-size:0.7rem; font-weight:600; padding:3px 10px; border-radius:20px; color:var(--text); }
    .nc-cross .niche-tag { background:rgba(255,255,255,0.12); color:var(--sand); }

    /* SERVICES */
    .services { padding:100px 48px; background:var(--cream); }
    .services-inner { max-width:1200px; margin:0 auto; }
    .services-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:56px; }
    .svc-card { background:var(--white); border:1px solid var(--border); border-radius:20px; padding:32px; transition:all 0.3s; }
    .svc-card:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(92,61,46,0.1); border-color:var(--rose); }
    .svc-card.featured-svc { background:var(--brown); border-color:var(--rose); }
    .svc-icon { font-size:2rem; margin-bottom:16px; }
    .svc-name { font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:900; color:var(--text); margin-bottom:10px; }
    .svc-card.featured-svc .svc-name { color:var(--warm); }
    .svc-desc { font-size:0.84rem; color:var(--muted); line-height:1.7; margin-bottom:20px; }
    .svc-card.featured-svc .svc-desc { color:#9a8070; }
    .svc-price { font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:900; color:var(--rose); line-height:1; }
    .svc-note { font-size:0.72rem; color:var(--muted); margin-top:2px; }
    .svc-card.featured-svc .svc-note { color:#7a6055; }
    .svc-list { list-style:none; margin-top:18px; border-top:1px solid var(--border); padding-top:18px; }
    .svc-card.featured-svc .svc-list { border-color:rgba(255,255,255,0.1); }
    .svc-list li { font-size:0.8rem; color:var(--muted); padding:4px 0; display:flex; align-items:center; gap:8px; }
    .svc-card.featured-svc .svc-list li { color:#9a8070; }
    .svc-list li::before { content:'→'; color:var(--rose); font-weight:700; }

    /* RATES */
    .rates { padding:100px 48px; background:var(--white); }
    .rates-inner { max-width:1200px; margin:0 auto; }
    .rates-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:56px; }
    .rate-card { background:var(--cream); border:1px solid var(--border); border-radius:20px; padding:32px; text-align:center; position:relative; transition:all 0.3s; }
    .rate-card:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(92,61,46,0.1); }
    .rate-card.featured-rate { background:var(--brown); border-color:var(--rose); }
    .rate-popular { position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:var(--rose); color:#fff; font-size:0.65rem; font-weight:700; padding:3px 14px; border-radius:20px; letter-spacing:0.08em; text-transform:uppercase; white-space:nowrap; }
    .rate-type { font-size:0.7rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--rose); margin-bottom:8px; }
    .rate-name { font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:900; color:var(--text); margin-bottom:4px; }
    .rate-card.featured-rate .rate-name { color:var(--warm); }
    .rate-price { font-family:'Playfair Display',serif; font-size:2.4rem; font-weight:900; color:var(--rose); line-height:1; margin:14px 0 4px; }
    .rate-period { font-size:0.72rem; color:var(--muted); margin-bottom:20px; }
    .rate-card.featured-rate .rate-period { color:#7a6055; }
    .rate-features { list-style:none; text-align:left; margin-bottom:24px; }
    .rate-features li { font-size:0.82rem; color:var(--muted); padding:5px 0; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px; }
    .rate-card.featured-rate .rate-features li { border-color:rgba(255,255,255,0.08); color:#9a8070; }
    .rate-features li:last-child { border-bottom:none; }
    .rate-features li::before { content:'✓'; color:var(--rose); font-weight:700; font-size:0.78rem; flex-shrink:0; }
    .rate-btn { display:block; text-align:center; padding:11px; border-radius:100px; font-weight:600; font-size:0.84rem; text-decoration:none; transition:all 0.2s; background:rgba(196,133,106,0.12); color:var(--rose); border:1px solid rgba(196,133,106,0.25); }
    .rate-btn:hover { background:var(--rose); color:#fff; }
    .rate-btn.filled { background:var(--rose); color:#fff; }
    .rate-btn.filled:hover { background:var(--rose-light); color:#fff; }

    /* CTA */
    .cta-section { padding:120px 48px; background:var(--rose); text-align:center; position:relative; overflow:hidden; }
    .cta-section::before { content:'COLLAB'; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-family:'Playfair Display',serif; font-size:20vw; font-weight:900; color:rgba(255,255,255,0.07); white-space:nowrap; pointer-events:none; }
    .cta-tag { font-size:0.72rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.7); margin-bottom:18px; }
    .cta-title { font-family:'Playfair Display',serif; font-size:clamp(2.5rem,6vw,5rem); font-weight:900; color:#fff; line-height:1.05; letter-spacing:-0.03em; margin-bottom:24px; }
    .cta-sub { font-size:1rem; color:rgba(255,255,255,0.75); max-width:460px; margin:0 auto 44px; line-height:1.75; }
    .btn-white { background:#fff; color:var(--rose); padding:15px 38px; border-radius:100px; font-weight:700; font-size:0.95rem; text-decoration:none; transition:all 0.25s; display:inline-block; box-shadow:0 8px 30px rgba(0,0,0,0.15); }
    .btn-white:hover { transform:translateY(-3px); box-shadow:0 14px 40px rgba(0,0,0,0.2); color:var(--rose); }
    .cta-contacts { display:flex; justify-content:center; gap:28px; margin-top:28px; flex-wrap:wrap; }
    .cta-contact { font-size:0.84rem; color:rgba(255,255,255,0.7); display:flex; align-items:center; gap:7px; }

    footer { background:var(--brown); padding:28px 48px; display:flex; justify-content:space-between; align-items:center; }
    footer p { font-size:0.75rem; color:#7a6055; }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { font-size:0.75rem; color:#7a6055; text-decoration:none; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; transition:color 0.2s; }
    .footer-links a:hover { color:var(--rose-light); }

    @media(max-width:900px){
      nav { padding:14px 20px; }
      .nav-links { display:none; }
      .hero { grid-template-columns:1fr; padding:90px 20px 60px; gap:40px; }
      .hero-right { display:none; }
      .about-grid { grid-template-columns:1fr; gap:36px; }
      .about-img-wrap { display:none; }
      .work-grid, .phones-grid, .niches-grid, .services-grid, .rates-grid { grid-template-columns:1fr; }
      .about, .work, .videos, .niches, .services, .rates, .cta-section { padding:70px 20px; }
      footer { flex-direction:column; gap:14px; text-align:center; padding:24px 20px; }
    }
  </style>
</head>
<body>

<nav>
  <a href="#" class="nav-logo">gabi <span>salviatti</span></a>
  <div class="nav-links">
    <a href="#work">Work</a>
    <a href="#videos">Videos</a>
    <a href="#niches">Niches</a>
    <a href="#rates">Rates</a>
    <a href="#contact" class="nav-cta">Work With Me</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-left">
    <div class="hero-tag">UGC Creator · Bilingual EN/PT</div>
    <h1 class="hero-title">
      Real content.
      <em>Real results.</em>
    </h1>
    <p class="hero-desc">
